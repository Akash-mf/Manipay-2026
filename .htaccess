# =========================================================
#  ManiPay Digital Payments — Apache / LiteSpeed config
# =========================================================

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

# ---------- Custom error pages ----------
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html
ErrorDocument 503 /503.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www → non-www (canonical domain is https://manipay.in)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Block dotfiles (.env, .git, .gitignore …) — .well-known stays reachable for SSL
  RewriteRule "(^|/)\.(?!well-known/)" - [F,L]

  # ---------- Maintenance mode ----------
  # Uncomment the 4 lines below to show 503.html to everyone except your IP.
  # RewriteCond %{REMOTE_ADDR} !^000\.000\.000\.000$
  # RewriteCond %{REQUEST_URI} !^/(503\.html|assets/)
  # RewriteCond %{REQUEST_URI} !^/favicon\.ico$
  # RewriteRule ^ - [R=503,L]

  # Clean URLs: /about → about.html (existing .html links keep working)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # Case-insensitive aliases for the capitalised pages
  RewriteRule ^faq(\.html)?/?$ /FAQ.html [NC,L]
  RewriteRule ^contact(\.html)?/?$ /Contact.html [NC,L]
</IfModule>

# Tell search engines and browsers to retry after maintenance
<IfModule mod_headers.c>
  <Files "503.html">
    Header always set Retry-After "3600"
  </Files>
</IfModule>

# ---------- Protect sensitive files ----------
<FilesMatch "^(\.env|\.gitignore|\.htaccess)$">
  Require all denied
</FilesMatch>

# ---------- Security headers ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  # Allows self-hosted assets, the Google Maps embed and your own API.
  # If the form posts to another domain, add it to connect-src.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline'; frame-src https://maps.google.com https://www.google.com; connect-src 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/manifest+json application/xml image/svg+xml
</IfModule>

# ---------- MIME types ----------
<IfModule mod_mime.c>
  AddType application/manifest+json .json
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

# ---------- Browser caching ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
