{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/faqs.html", "destination": "/FAQ.html", "permanent": true },
    { "source": "/faqs", "destination": "/FAQ.html", "permanent": true },
    { "source": "/service-details.html", "destination": "/services.html#credit-card-swipe", "permanent": true },
    { "source": "/projects.html", "destination": "/services.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    },
    {
      "source": "/.env",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
